# 复制此文件为 .env，填入对应的 API Key

# Claude 系列（Anthropic）的 API Key
# 使用 claude-sonnet-4-6 或 claude-opus-4-7 时需要配置
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Qwen 系列（阿里云 DashScope）的 API Key
# 使用 qwen-max、qwen-plus 或 qwen3-235b-a22b 时需要配置
# 在阿里云控制台获取：https://dashscope.console.aliyun.com/apiKey
QWEN_API_KEY=your_qwen_api_key_here
